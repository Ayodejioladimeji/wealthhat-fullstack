{
  "name": "wealth_backend",
  "version": "1.0.0",
  "description": "An investment advisor that’s focused on you",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "cd client && npm run start",
    "server-install": "npm install",
    "client-install": "cd client && npm install",
    "install-all": "concurrently \"npm run server-install\" \"npm run client-install\"",
    "dev": "concurrently -n 'server,client' -c 'red,green' \"npm run server\" \"npm run client\"",
    "heroku-postbuild": "cd client && npm install && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayodejioladimeji/wealthhat-backend.git"
  },
  "keywords": [
    "Investment",
    "Wealthhat",
    "Save",
    "Credit",
    "Savings",
    "Invest"
  ],
  "author": "Layobright",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ayodejioladimeji/wealthhat-backend/issues"
  },
  "homepage": "https://github.com/Ayodejioladimeji/wealthhat-backend#readme",
  "dependencies": {
    "bcrypt": "^5.0.1",
    "cloudinary": "^1.28.1",
    "concurrently": "^7.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^11.0.0",
    "express": "^4.17.2",
    "express-fileupload": "^1.2.1",
    "express-validator": "^6.14.0",
    "googleapis": "^92.0.0",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.1.6",
    "node-fetch": "^3.1.0",
    "nodemailer": "^6.7.2",
    "nodemon": "^2.0.15",
    "react-hooks-helper": "^1.6.0"
  }
}
